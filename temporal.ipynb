    "\n",
    "from pyspark.sql import SparkSession\n",
    "\n",
    "spark = SparkSession.builder \\\n",
    "    .appName(\"Accidents Dataset\") \\\n",
    "    .getOrCreate()\n",
    "\n",
    "df = spark.read.option(\"header\", True).csv(\n",
    "    \"hdfs://namenode:9000/user/gyembo/project/traffic_cleaned_eda_csv\"\n",
    ")\n",
    "df.show(5)\n",
    "df.printSchema()"
   ]
  },
